# Copy this file to .env (never commit the real .env).
# All variables are optional - the site renders sensible fallbacks without them.

# Calendly event URL (the full "book a call" link)
PUBLIC_CALENDLY_URL=https://calendly.com/your-link/strategy-call

# External audit tool URL (phase 2 - the free instant audit tool)
PUBLIC_AUDIT_TOOL_URL=https://audit.maz.agency

# VSL - paste a YouTube or Vimeo watch URL here. Leave blank to hide the player.
# Examples:
#   https://www.youtube.com/watch?v=dQw4w9WgXcQ
#   https://vimeo.com/123456789
PUBLIC_VSL_URL=

# Plausible analytics domain. Leave blank to disable.
PUBLIC_PLAUSIBLE_DOMAIN=www.wearemaz.com

# Google Analytics 4 measurement ID (loads only after analytics consent)
# Example: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion / remarketing ID (loads only after advertising consent)
# Example: AW-123456789
PUBLIC_GOOGLE_ADS_ID=

# Meta Pixel ID (loads only after advertising consent)
PUBLIC_META_PIXEL_ID=
