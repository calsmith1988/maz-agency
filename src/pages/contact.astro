---
import Base from "~/layouts/Base.astro";
import CTAButton from "~/components/CTAButton.astro";
import { site } from "~/config/site";
---

<Base
  title="Contact"
  description="Get in touch with MAZ. Book a strategy call, send a note, or start with a free assessment."
>
  <section class="section">
    <div class="container-page grid md:grid-cols-[1fr_1.1fr] gap-12 lg:gap-20">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-5 text-balance">Let&rsquo;s talk.</h1>
        <p class="lead mt-6">
          The quickest path is usually a 30-minute call. If you&rsquo;d rather
          write, the form does the same job.
        </p>

        <div class="mt-10 space-y-5 text-[0.98rem]">
          <div>
            <p class="eyebrow">Email</p>
            <a
              href={`mailto:${site.contact.email}`}
              class="mt-2 inline-block font-serif text-[1.2rem] text-ink underline underline-offset-4 decoration-gold hover:decoration-ink"
            >
              {site.contact.email}
            </a>
          </div>
          <div>
            <p class="eyebrow">Phone / WhatsApp</p>
            <a
              href={`tel:${site.contact.phone.replace(/\s+/g, "")}`}
              class="mt-2 inline-block font-serif text-[1.2rem] text-ink underline underline-offset-4 decoration-gold hover:decoration-ink"
            >
              {site.contact.phone}
            </a>
          </div>
          <div>
            <p class="eyebrow">Based in</p>
            <p class="mt-2 font-serif text-[1.2rem]">{site.contact.location}</p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <CTAButton href="/book-a-call" size="lg">Book a call</CTAButton>
          <CTAButton href="/assessment" variant="secondary" size="lg">
            Free assessment
          </CTAButton>
        </div>
      </div>

      <form
        class="bg-champagne border border-putty rounded-lg p-6 md:p-9 space-y-5"
        action={`mailto:${site.contact.email}`}
        method="post"
        enctype="text/plain"
      >
        <p class="eyebrow">Quick message</p>
        <h2 class="text-[1.6rem]">Tell us about your account.</h2>

        <div class="grid gap-5">
          <label class="block">
            <span class="text-[0.82rem] tracking-wide text-moss">Your name</span>
            <input
              type="text"
              name="name"
              required
              class="mt-2 w-full bg-ivory border border-putty rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-ink"
            />
          </label>

          <label class="block">
            <span class="text-[0.82rem] tracking-wide text-moss">Email</span>
            <input
              type="email"
              name="email"
              required
              class="mt-2 w-full bg-ivory border border-putty rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-ink"
            />
          </label>

          <label class="block">
            <span class="text-[0.82rem] tracking-wide text-moss">Brand name</span>
            <input
              type="text"
              name="brand"
              class="mt-2 w-full bg-ivory border border-putty rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-ink"
            />
          </label>

          <label class="block">
            <span class="text-[0.82rem] tracking-wide text-moss">Your role</span>
            <select
              name="role"
              class="mt-2 w-full bg-ivory border border-putty rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-ink"
            >
              <option value="">Choose an option...</option>
              <option>Founder</option>
              <option>Director</option>
              <option>Marketing Manager</option>
              <option>E-commerce Manager</option>
              <option>Amazon Ads Specialist</option>
              <option>Other</option>
            </select>
          </label>

          <label class="block">
            <span class="text-[0.82rem] tracking-wide text-moss">
              Anything we should know (monthly ad spend, marketplaces, pain points)
            </span>
            <textarea
              name="message"
              rows="5"
              class="mt-2 w-full bg-ivory border border-putty rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-ink"
            ></textarea>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-ink text-ivory font-medium rounded-sm hover:bg-[#0f1714] transition-colors"
        >
          Send message
        </button>

        <p class="text-[0.78rem] leading-relaxed text-moss">
          By contacting us, you agree that we may use the information you send
          to respond to your enquiry, assess whether we can help, and record
          the conversation in our CRM. We do not add you to marketing emails
          just because you contact us. See our
          <a
            href="/privacy"
            class="text-ink underline underline-offset-4 decoration-gold hover:decoration-ink"
          >
            privacy policy
          </a>
          and
          <a
            href="/cookies"
            class="text-ink underline underline-offset-4 decoration-gold hover:decoration-ink"
          >
            cookie notice
          </a>
          for more detail.
        </p>

        <p class="text-[0.78rem] text-moss">
          This form opens your email client with a pre-filled message. For a
          wired-up form, swap the <code>action</code> for a Formspree or
          Resend endpoint.
        </p>
      </form>
    </div>
  </section>
</Base>
