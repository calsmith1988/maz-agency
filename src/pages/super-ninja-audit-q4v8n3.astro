  .member-role {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-moss);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .kpi {
    font-size: clamp(1.3rem, 1rem + 0.8vw, 1.6rem);
    color: var(--color-ink);
  }

  .kpi-label {
    margin-top: 0.3rem;
