  /* --- Sticky nav extras --- */
  .doc-nav {
    transition: box-shadow 0.35s ease;
  }

  .doc-nav.is-scrolled {
    box-shadow: 0 10px 28px -20px rgba(30, 42, 36, 0.4);
  }

  .doc-nav-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    transition:
      color 0.25s ease,
      text-decoration-color 0.25s ease;
  }

  .doc-nav-link.is-active {
    color: var(--color-ink);
    text-decoration-color: var(--color-gold);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    display: block;
  }

  .progress-fill {
    display: block;
    height: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.1s linear;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) {
    .pdf-btn:hover {
