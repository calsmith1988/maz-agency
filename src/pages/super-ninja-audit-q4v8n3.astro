  }

  .stages::before {
    background: var(--color-putty);
  }

  .stages::after {
    background: var(--color-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.35s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  .stages:has(.is-visible)::after {
    transform: scaleY(1);
  }

  .stage {
    position: relative;
    padding-bottom: 1.9rem;
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  .stage::before {
    content: "";
    position: absolute;
    left: -1.9rem;
    top: 0.28rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-ivory);
    border: 2px solid var(--color-gold);
    transition:
      background 0.45s ease,
      box-shadow 0.45s ease;
  }

  .stage.is-visible::before {
    background: var(--color-gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-gold) 22%, transparent);
  }

  .stage-eyebrow {
    color: var(--color-ink);
  }

  .stage-num {
    color: var(--color-gold);
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  /* --- Sticky nav extras --- */
  .doc-nav {
    transition: box-shadow 0.35s ease;
  }

  .doc-nav.is-scrolled {
    box-shadow: 0 10px 28px -20px rgba(30, 42, 36, 0.4);
  }

  .doc-nav-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    transition:
      color 0.25s ease,
      text-decoration-color 0.25s ease;
  }

  .doc-nav-link.is-active {
    color: var(--color-ink);
    text-decoration-color: var(--color-gold);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    display: block;
  }

  .progress-fill {
    display: block;
    height: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.1s linear;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) {
    .pdf-btn:hover {
      background: var(--color-gold);
      color: var(--color-ivory);
    }
  }

  /* --- Print --- */
  @media print {
    .doc-nav {
      display: none;
    }

    .doc-section {
      padding-top: 1.4rem;
      margin-top: 1.2rem;
    }

    .finding,
    .ad-finding,
    .evidence {
      break-inside: avoid;
    }

    :global(html.js-anim) :global([data-reveal]) {
      opacity: 1 !important;
      transform: none !important;
    }

    :global(html.js-anim) .statement::after,
    :global(html.js-anim) .closing::after,
    :global(html.js-anim) .doc-section::after {
      transform: scaleX(1) !important;
    }

    .stages::after {
      transform: scaleY(1) !important;
    }

    :global(html.js-anim) .doc-list[data-reveal] li {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  /* Reveal on scroll */
  const nodes = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
  const show = (el: Element) => el.classList.add("is-visible");

  if (!("IntersectionObserver" in window)) {
    nodes.forEach(show);
  } else {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target);
          revealObserver.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );

    for (const node of nodes) revealObserver.observe(node);
  }

  window.setTimeout(() => nodes.forEach(show), 1500);

  /* Download / print to PDF */
  document
    .querySelector<HTMLButtonElement>("[data-print]")
    ?.addEventListener("click", () => {
      nodes.forEach(show);
      window.print();
    });

  /* Reading progress bar */
  const fill = document.querySelector<HTMLElement>("[data-progress]");
  const navBar = document.querySelector<HTMLElement>("[data-doc-nav]");
  const updateProgress = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (fill) fill.style.transform = `scaleX(${max > 0 ? doc.scrollTop / max : 0})`;
    navBar?.classList.toggle("is-scrolled", doc.scrollTop > 8);
  };
  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress, { passive: true });
  updateProgress();

  /* Active nav link highlighting */
  const navAnchors = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-doc-nav] a[href^='#']"),
  ];
  const sections = navAnchors
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => Boolean(section));

  const setActive = (id: string) => {
    for (const link of navAnchors) {
      const active = link.hash === `#${id}`;
      link.classList.toggle("is-active", active);
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
  };

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible?.target.id) setActive(visible.target.id);
    },
    { rootMargin: "-18% 0px -68% 0px", threshold: [0, 0.15, 0.4] },
  );

  for (const section of sections) sectionObserver.observe(section);
  if (sections[0]) setActive(sections[0].id);

  navAnchors.forEach((link) => {
    link.addEventListener("click", (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", link.hash);
    });
  });
</script>
