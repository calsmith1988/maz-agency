  { when: "Profit per day falls while spend rises", then: "Check price, costs and stock. Then step back to the last profitable spend level and grow more slowly." },
];

const plan = [
  {
    num: "1",
    title: "Days 1–30",
    subtitle: "Learn, check, steady the account, quick wins",
    items: [
      "Agree break-even and target ACOS for each product and market with Super Ninja.",
      "Block the confirmed wasted searches (UK electric, UV and “fly max”; German wasp searches).",
      "US: bring the 4-pack's general search terms back under a profit-based ACOS limit.",
      "Germany: review 4-pack vs 2-pack spend. Fix the 2-pack's bids first.",
      "German fungus gnat: reset bids on the main terms so campaigns run all day, then start the winter plan in early October.",
      "Set up a weekly review: market, then product, then search term.",
    ],
    measure: "Targets agreed. Wasted spend down. Starting figures recorded and the first tests running.",
  },
  {
    num: "2",
    title: "Days 30–60",
    subtitle: "Test, refine, prioritise",
    items: [
      "Top-of-search tests on UK and German main terms, tracking rank.",
      "Test 6- and 12-pack campaigns in the US.",
      "Separate general “fly” campaigns in the UK, then Germany.",
      "German fungus gnat winter push live; 60-pack advertised.",
      "Review each loss-making product: grow, fix or stop.",
    ],
    measure: "First tests judged once there are enough orders. Better profit without losing sales or share. German fungus gnat spend following demand.",
  },
  {
    num: "3",
    title: "Days 60–90",
    subtitle: "Build on what works",
    items: [
      "Roll out what worked across markets (product targeting, low-bid automatic campaigns).",
      "A seasonal budget plan per market and product for 2027.",
      "A weekly view of the numbers we make decisions on.",
      "Product ideas for 2027: UK ant spray, a German silverfish bait box, nematodes.",
      "A pre-season plan for March–May 2027.",
    ],
    measure: "Profit and TACOS better than the same season last year. A clear plan for 2027.",
  },
];

const dataNotes = [
  "Monthly exports from June 2025 to 23 September 2026 (US and German product data from July 2025). September 2026 is part of a month, marked *.",
  "Amazon stores only. The market split is in US dollars. Market and product figures are in local currency (£, $, €), so exchange rates don't affect changes on last year.",
  "Profit is the figure in the exports. We'd confirm which costs it includes before setting break-even targets.",
  "Search data (March–September 2026, UK from April) comes from weekly reports, and the weeks covered vary by search term. We use it for shares and comparisons, not exact search counts.",
];
---

<WorkingDoc
  title="Super Ninja Audit"
  description="Amazon account audit for Super Ninja: what drives sales, where money is wasted, and how we'd run the account for the next 90 days."
>
  <header
    class="doc-nav sticky top-0 z-40 bg-ivory/90 backdrop-blur-md border-b border-putty/50"
    data-doc-nav
  >
    <div class="wrap wrap-nav flex items-center justify-between gap-4 md:gap-6 h-14 md:h-16">
      <div class="flex items-baseline gap-3 shrink-0">
        <span
          class="font-serif text-[1.35rem] md:text-[1.45rem] tracking-[0.18em] font-medium leading-none"
        >
          MAZ
        </span>
        <span
          class="hidden sm:inline font-sans text-[0.62rem] tracking-[0.22em] uppercase text-moss truncate"
        >
          Audit · September 2026
        </span>
      </div>

      <nav
        class="doc-nav-links flex items-center gap-4 md:gap-6 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden min-w-0"
        aria-label="On this page"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="doc-nav-link shrink-0 text-[0.78rem] md:text-[0.85rem] text-moss hover:text-ink transition-colors py-1"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <button class="pdf-btn shrink-0" type="button" data-print>
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 2v8m0 0 3-3m-3 3L5 7" />
          <path d="M2.5 11.5v1a1.5 1.5 0 0 0 1.5 1.5h8a1.5 1.5 0 0 0 1.5-1.5v-1" />
        </svg>
        <span class="hidden md:inline">Download&nbsp;PDF</span>
        <span class="md:hidden">PDF</span>
      </button>
    </div>
    <span class="progress" aria-hidden="true">
      <span class="progress-fill" data-progress></span>
    </span>
  </header>

  <main class="pb-8">
    {/* 1. Opening */}
    <section id="overview" class="wrap scroll-mt-16 pt-14 md:pt-20 pb-4">
      <div data-reveal>
        <p class="eyebrow">Super Ninja × MAZ · Account audit</p>
        <h1 class="mt-4 text-balance">What drives Super Ninja's sales, and where money is wasted</h1>
        <p class="mt-5 text-[1.1rem] md:text-[1.18rem] leading-relaxed text-moss max-w-[54ch]">
          We looked at 15 months of Amazon sales, profit, ad and search data for
          the UK, Germany and the US. Here is what matters most, and what we
          would do about it.
        </p>
      </div>

      <ol class="agenda" data-reveal style="--reveal-delay: 120ms">
        {
          agenda.map((item) => (
            <li>
              <span class="agenda-num stat-figure">{item.num}</span>
              <span class="agenda-title">{item.title}</span>
              <span class="agenda-meta">
                {item.time} · {item.who}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="account" class="doc-section wrap">
      <div data-reveal>
        <p class="eyebrow">1 · Opening · 5 min · The account</p>
        <p class="doc-p mt-5">
          From September 2025 to August 2026, Super Ninja sold
          <strong>$18.0M</strong> across 10 Amazon stores. The UK, Germany and
          the US make up <strong>83% of those sales</strong> and
          <strong>83% of ad spend</strong>, so that's where we focused.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 my-8">
        {
          markets.map((m, i) => (
            <div class="card p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <p class="member-role">{m.name}</p>
              <div class="kpis">
                <div>
                  <p class="kpi stat-figure">{m.sales}</p>
                  <p class="kpi-label">of sales</p>
                </div>
                <div>
                  <p class="kpi stat-figure">{m.spend}</p>
                  <p class="kpi-label">of ad spend</p>
                </div>
                <div>
                  <p class="kpi stat-figure">{m.tacos}</p>
                  <p class="kpi-label">TACOS</p>
                </div>
              </div>
              <p class="mt-4 text-[0.92rem] leading-relaxed text-moss">{m.note}</p>
            </div>
          ))
        }
      </div>

      <div class="evidence" data-reveal>
        <p class="eyebrow evidence-eyebrow">Monthly sales by marketplace (USD, thousands)</p>
        <LineChart
          labels={monthLabels}
          unit="$"
          suffix="k"
          partialFrom={15}
          ariaLabel="Monthly sales by marketplace, June 2025 to September 2026"
          series={[
            { name: "United Kingdom", values: marketSales.UK, color: INK },
            { name: "Germany", values: marketSales.DE, color: GOLD },
            { name: "United States", values: marketSales.US, color: MOSS, dashed: true },
          ]}
          caption="The UK has a sharp summer peak. The US is flatter and peaks later. Germany holds up through winter. *September 2026 covers the 1st–23rd."
        />
      </div>

      <div data-reveal>
        <p class="eyebrow mt-10">Terms we use</p>
      </div>
      <dl class="terms mt-4" data-reveal style="--reveal-delay: 70ms">
        {
          terms.map((t) => (
            <div>
              <dt>{t.term}</dt>
              <dd>{t.meaning}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="approach" class="doc-section wrap">
      <div data-reveal>
        <p class="eyebrow">How we think</p>
        <p class="doc-p mt-5">
          We look at the account on two levels. First, where the business
          should grow. Second, the day-to-day
          ad changes that get it there. Each one informs the other.
        </p>
      </div>
      <div class="flow" data-reveal style="--reveal-delay: 80ms">
        Plan → Make the ad changes → Check the results → Adjust
      </div>

      <p class="eyebrow mt-10" data-reveal>How we would manage it</p>
      <div class="stages mt-8">
        {
          principles.map((p, i) => (
            <div class="stage" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <p class="eyebrow stage-eyebrow">
                <span class="stage-num stat-figure">{i + 1}</span> · {p.title}
              </p>
              <p class="doc-p mt-3">{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="statement" data-reveal>
        We judge ads on profit and total sales, not on ad sales alone.
      </p>
    </section>

    {/* 2. Our view */}
    <section id="view" class="doc-section wrap scroll-mt-16">
      <div data-reveal>
        <p class="eyebrow">2 · Our view · 5 min</p>
        <h2 class="mt-4 text-balance">Five things that matter most</h2>
      </div>
      <ol class="view-list mt-8">
        {
          view.map((v, i) => (
            <li class="card view-card p-6 md:p-7" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <div class="view-head">
                <span class="stat-figure view-num">{v.num}</span>
                <span class="member-role !mb-0">{v.tag}</span>
              </div>
              <div class="view-body">
                <div>
                  <h3 class="text-[1.2rem] md:text-[1.3rem] leading-snug text-balance">
                    <a href={`#${findings[i].id}`} class="view-link">{v.title}</a>
                  </h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-moss">{v.body}</p>
                </div>
                <div class="view-stat">
                  <p class="stat-figure view-stat-num">{v.stat}</p>
                  <p class="kpi-label">{v.statLabel}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* 3. Findings */}
    <section id="findings" class="doc-section wrap scroll-mt-16">
      <div data-reveal>
        <p class="eyebrow">3 · Findings in detail · 10 min</p>
        <h2 class="mt-4 text-balance">What we found, and what we'd do about it</h2>
        <p class="doc-p mt-5">
          Each finding has the same parts: what we found, the evidence, why it
          matters, what we would do, and how we would measure it.
        </p>
      </div>

      {
        findings.map((f) => (
          <article id={f.id} class="finding scroll-mt-16">
            <div data-reveal>
              <p class="eyebrow finding-eyebrow">
                <span class="stat-figure finding-num">{f.num}</span> · {f.tag}
              </p>
              <h3 class="finding-title text-balance">{f.title}</h3>
            </div>

            <p class="part-label" data-reveal>What we found</p>
            <ul class="doc-list" data-reveal>
              {f.found.map((item) => <li>{item}</li>)}
            </ul>

            <div class="evidence" data-reveal>
              <p class="eyebrow evidence-eyebrow">Evidence</p>

              {f.id === "f-uk" && (
                <BarChart
                  labels={monthLabels}
                  stacked
                  unit="£"
                  suffix="k"
                  partialFrom={15}
                  highlight={[2, 3, 14, 15]}
                  ariaLabel="UK monthly organic versus ad-attributed sales"
                  series={[
                    { name: "Organic sales", values: ukOrganic, color: INK },
                    { name: "Sales linked to ads", values: ukAd, color: GOLD },
                  ]}
                  caption="UK sales (£k), split into organic sales and sales linked to ads. In August and September (highlighted), organic sales were flat or lower than last year, while sales linked to ads rose sharply (+77% in August). In September 2025, ads ran at about £570 a day."
                />
              )}

              {f.id === "f-us" && (
                <BarChart
                  labels={fromJul}
                  unit="$"
                  suffix="k"
                  partialFrom={14}
                  highlight={[11, 12, 13]}
                  ariaLabel="US monthly profit versus ad spend"
                  series={[
                    { name: "Profit", values: usProfit, color: INK },
                    { name: "Ad spend", values: usSpend, color: GOLD },
                  ]}
                  caption="US profit and ad spend ($k). From June to August 2026, spend rose from $62k to $90k while profit fell from $125k to $95k. *September covers the 1st–23rd only: profit per day is up 27% on August, but 11% below September 2025."
                />
              )}

              {f.id === "f-us" && (
                <div class="split mt-8">
                  <p class="split-title">Share of US ad spend vs share of total sales (12 months)</p>
                  {usSkus.map((s) => (
                    <div class="split-row">
                      <span class="split-name">{s.name}</span>
                      <div class="split-bars">
                        <span class="split-bar split-bar--sales" style={`--w: ${s.sales}%`}>
                          <span>{s.sales}% sales</span>
                        </span>
                        <span class="split-bar split-bar--spend" style={`--w: ${s.spend}%`}>
                          <span>{s.spend}% spend</span>
                        </span>
                      </div>
                      <span class="split-acos">ACOS {s.acos}</span>
                    </div>
                  ))}
                </div>
              )}

              {f.id === "f-de" && (
                <div class="split">
                  <p class="split-title">Share of German ad spend vs share of total sales (12 months)</p>
                  {deSkus.map((s) => (
                    <div class="split-row">
                      <span class="split-name">{s.name}</span>
                      <div class="split-bars">
                        <span class="split-bar split-bar--sales" style={`--w: ${s.sales}%`}>
                          <span>{s.sales}% sales</span>
                        </span>
                        <span class="split-bar split-bar--spend" style={`--w: ${s.spend}%`}>
                          <span>{s.spend}% spend</span>
                        </span>
                      </div>
                      <span class="split-acos">ACOS {s.acos}</span>
                    </div>
                  ))}
                </div>
              )}

              {f.id === "f-de" && (
                <div class="stat-row mt-8">
                  <div>
                    <p class="stat-figure stat-big">33k → 16k</p>
                    <p class="kpi-label">4-pack ad clicks, Aug 2025 → Aug 2026</p>
                  </div>
                  <div>
                    <p class="stat-figure stat-big">€13k → €31k</p>
                    <p class="kpi-label">2-pack ad spend, same months (42% ACOS)</p>
                  </div>
                  <div>
                    <p class="stat-figure stat-big">−26%</p>
                    <p class="kpi-label">4-pack sales in August</p>
                  </div>
                </div>
              )}

              {f.id === "f-fg" && (
                <BarChart
                  labels={fromJul}
                  unit="€"
                  suffix="k"
                  partialFrom={14}
                  highlight={[11, 12, 13]}
                  ariaLabel="Germany fungus gnat monthly sales and ad spend"
                  series={[
                    { name: "Fungus gnat sales", values: fgSales, color: INK },
                    { name: "Ad spend", values: fgSpend, color: GOLD },
                  ]}
                  caption="Germany fungus gnat (€k). Sales peak from November to March. In summer 2026 (highlighted), ad spend stayed close to winter levels while sales halved, at 62–78% ACOS."
                />
              )}

              {f.id === "f-fg" && (
                <div class="table-wrap mt-8">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Market</th>
                        <th>Fungus gnat searches for each fruit fly search</th>
                        <th>Our share of fungus gnat purchases</th>
                        <th>Our share of fruit fly purchases</th>
                      </tr>
                    </thead>
                    <tbody>
                      {demand.map((d) => (
                        <tr>
                          <td>{d.market}</td>
                          <td class="accent">{d.ratio}</td>
                          <td>{d.share}</td>
                          <td>{d.ffShare}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="chart-caption">
                    Indicative, from the search terms we track in Amazon's Search Query Performance report, March–August 2026 (UK from April). Winter, when fungus gnat peaks, isn't in the data yet.
                  </p>
                </div>
              )}

              {f.id === "f-pf" && (
                <div class="split">
                  <p class="split-title">Fruit fly traps' share of sales, and off-season sales as a share of peak</p>
                  {concentration.map((c) => (
                    <div class="split-row">
                      <span class="split-name">{c.market}</span>
                      <div class="split-bars">
                        <span class="split-bar split-bar--sales" style={`--w: ${c.ff}%`}>
                          <span>{c.ff}% fruit fly</span>
                        </span>
                      </div>
                      <span class="split-acos">Off-season {c.offPeak}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class="grid gap-5 md:grid-cols-2 mt-8">
              <div data-reveal>
                <p class="part-label">Why it matters</p>
                <p class="doc-p mt-3">{f.matters}</p>
              </div>
              <div data-reveal style="--reveal-delay: 60ms">
                <p class="part-label">What we'd do</p>
                <ul class="doc-list doc-list--tight">
                  {f.todo.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>

            <div class="measure" data-reveal>
              <p class="part-label">How we measure it</p>
              <ul class="chips">
                {f.measure.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    {/* 4. Amazon Ads findings */}
    <section id="ads" class="doc-section wrap scroll-mt-16">
      <div data-reveal>
        <p class="eyebrow">4 · Amazon Ads findings · 10–12 min · Genny</p>
        <h2 class="mt-4 text-balance">Where ad money is wasted, and where it could do more</h2>
        <p class="doc-p mt-5">
          Genny reviewed campaigns, search terms and ad placements, mostly from
          11 July to 9 September 2026. Her findings and our 15-month view point
          the same way. Hers show <em>how</em> the bigger patterns happen.
        </p>
      </div>

      <div class="evidence" data-reveal>
        <p class="eyebrow evidence-eyebrow">The background: clicks cost more, and fewer people click</p>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Jul–Aug, vs last year</th>
                <th>CPC</th>
                <th>Change</th>
                <th>Times ads were shown</th>
                <th>Clicks</th>
              </tr>
            </thead>
            <tbody>
              {
                cpc.map((c) => (
                  <tr>
                    <td>{c.market}</td>
                    <td>
                      {c.from} → {c.to}
                    </td>
                    <td class="accent">{c.change}</td>
                    <td>{c.impr}</td>
                    <td>{c.clicks}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="chart-caption">
          In every market, ads were shown far more often, but clicks didn't keep up. The share of people who clicked fell by 42–55%, while each click cost more. The totals alone don't tell us why. We'd check where the ads showed, which searches they showed on, competition, and how the listings look.
        </p>
      </div>

      {
        adFindings.map((a) => (
          <article class="ad-finding card p-6 md:p-8" data-reveal>
            <p class="eyebrow finding-eyebrow">
              <span class="stat-figure finding-num">{a.num}</span> · Ads finding
            </p>
            <h3 class="mt-3 text-[1.3rem] md:text-[1.45rem] text-balance">{a.title}</h3>

            <p class="part-label mt-6">What we found</p>
            <ul class="doc-list doc-list--card">
              {a.found.map((item) => <li>{item}</li>)}
            </ul>

            <div class="grid gap-5 md:grid-cols-2 mt-4">
              <div>
                <p class="part-label">Why it matters</p>
                <p class="doc-p mt-3 text-[0.97rem]">{a.matters}</p>
              </div>
              <div>
                <p class="part-label">What we'd do</p>
                <ul class="doc-list doc-list--card doc-list--tight">
                  {a.todo.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>

            <p class="part-label mt-4">How we measure it</p>
            <ul class="chips chips--card">
              {a.measure.map((m) => <li>{m}</li>)}
            </ul>
          </article>
        ))
      }

      <div class="mt-12" data-reveal>
        <p class="eyebrow">Bringing the two together</p>
        <div class="table-wrap mt-5">
          <table class="data-table">
            <thead>
              <tr>
                <th>Genny's finding (Jul–Sep)</th>
                <th>What the 15 months of data add</th>
              </tr>
            </thead>
            <tbody>
              {
                agreement.map((row) => (
                  <tr>
                    <td>{row.genny}</td>
                    <td>{row.data}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="build my-10" data-reveal>
        <p class="eyebrow build-eyebrow">One adjustment</p>
        <p class="doc-p mt-3">
          The German 2-pack campaign runs out of budget by around 4pm. The
          obvious fix is more budget. But over 12 months the 2-pack has been
          the weaker product (42% ACOS against 24% for the 4-pack). So we'd
          check its search terms and fix its bids first, and test giving the
          spare budget to the 4-pack.
        </p>
      </div>

      <div data-reveal>
        <p class="eyebrow">What we check in every account</p>
      </div>
      <ul class="doc-list" data-reveal style="--reveal-delay: 70ms">
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {/* 5. How we make decisions */}
    <section id="decisions" class="doc-section wrap scroll-mt-16">
      <div data-reveal>
        <p class="eyebrow">5 · How we make decisions · 12 min</p>
        <h2 class="mt-4 text-balance">Every change answers one question</h2>
      </div>
      <p class="statement" data-reveal>Does this make more profitable sales?</p>

      <div data-reveal>
        <p class="eyebrow mt-10">What we watch, from the top down</p>
      </div>
      <div class="metric-stack mt-6" data-reveal style="--reveal-delay: 70ms">
        {
          metrics.map((m, i) => (
            <div class="metric-row" style={`--indent: ${i}`}>
              <span class="metric-level">{m.level}</span>
              <span class="metric-items">{m.items}</span>
            </div>
          ))
        }
      </div>
      <p class="doc-p mt-6" data-reveal>
        ACOS tells us how efficient a campaign is. TACOS and organic share
        give useful context, but they can't tell us on their own which sales
        the ads created. So we judge changes on profit and total sales, and
        test changes where we can.
      </p>

      <div data-reveal>
        <p class="eyebrow mt-12">When TACOS is above target, we check in this order</p>
      </div>
      <ol class="levers mt-6" data-reveal style="--reveal-delay: 70ms">
        {
          levers.map((l, i) => (
            <li>
              <span class="stat-figure lever-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="lever-title">{l.title}</span>
              <span class="lever-body">{l.body}</span>
            </li>
          ))
        }
      </ol>
      <p class="doc-p mt-6" data-reveal>
