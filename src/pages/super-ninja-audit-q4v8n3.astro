    class="doc-nav sticky top-0 z-40 bg-ivory/90 backdrop-blur-md border-b border-putty/50"
    data-doc-nav
  >
    <div class="wrap wrap-nav flex items-center justify-between gap-4 md:gap-6 h-14 md:h-16">
