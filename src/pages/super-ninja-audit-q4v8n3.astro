    padding-top: clamp(3rem, 2rem + 3vw, 4rem);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    scroll-margin-top: 4.5rem;
  }

  .doc-section::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-putty);
    transform-origin: left center;
  }

  :global(html.js-anim) .doc-section::after {
    transform: scaleX(0);
    transition: transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.js-anim) .doc-section:has(.is-visible)::after {
    transform: scaleX(1);
  }

  .doc-p {
    max-width: 62ch;
    margin-bottom: 0.85rem;
    line-height: 1.65;
  }

  /* --- Agenda --- */
  .agenda {
    list-style: none;
    padding: 0;
    margin: 2.4rem 0 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-putty);
  }

  .agenda li {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-putty);
  }

  .agenda-num {
    color: var(--color-gold);
    font-size: 1.05rem;
  }

  .agenda-title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
  }

  .agenda-meta {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-moss);
    text-align: right;
  }

  /* --- Lists: gold dot + hairline dividers --- */
  .doc-list {
    list-style: none;
    margin: 1.1rem 0 1.4rem;
    padding: 0;
  }

  .doc-list li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.65rem;
    border-bottom: 1px solid var(--color-putty);
    max-width: 66ch;
    line-height: 1.55;
  }

  .doc-list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.1em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold);
    transition: transform 0.3s ease;
  }

  .doc-list li:hover::before {
    transform: scale(1.35);
  }

  .doc-list--tight {
    margin-top: 0.6rem;
  }

  .doc-list--tight li {
    font-size: 0.97rem;
  }

  .doc-list--card li {
    border-bottom-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
    font-size: 0.97rem;
  }

  .doc-list--notes li {
    font-size: 0.9rem;
    color: var(--color-moss);
  }

  :global(html.js-anim) .doc-list[data-reveal] li {
    opacity: 0;
    transform: translateY(7px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  :global(html.js-anim) .doc-list[data-reveal].is-visible li {
    opacity: 1;
    transform: none;
  }

  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(1) { transition-delay: 40ms; }
  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(2) { transition-delay: 80ms; }
  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(3) { transition-delay: 120ms; }
  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(4) { transition-delay: 160ms; }
  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(5) { transition-delay: 200ms; }
  :global(html.js-anim) .doc-list[data-reveal].is-visible li:nth-child(6) { transition-delay: 240ms; }

  /* --- Statement + closing lines with gold draw-in underline --- */
  .statement {
    font-family: var(--font-serif);
    font-weight: 450;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2rem);
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 1.6rem 0;
    max-width: 28ch;
    text-wrap: balance;
  }

  .closing {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.5rem);
    line-height: 1.15;
    margin: 2.4rem 0 1.1rem;
    max-width: 22ch;
    text-wrap: balance;
  }

  .statement::after,
  .closing::after {
    content: "";
    display: block;
    margin-top: 0.9rem;
    width: 3.5rem;
    height: 3px;
    border-radius: 999px;
    background: var(--color-gold);
    transform-origin: left center;
  }

  :global(html.js-anim) .statement::after,
  :global(html.js-anim) .closing::after {
    transform: scaleX(0);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;
  }

  :global(html.js-anim) .statement:global(.is-visible)::after,
  :global(html.js-anim) .closing:global(.is-visible)::after {
    transform: scaleX(1);
  }

  .flow {
    font-family: var(--font-serif);
    font-weight: 450;
    letter-spacing: -0.01em;
    text-align: center;
    margin: 2.1rem 0;
    font-size: clamp(1.2rem, 0.95rem + 1.3vw, 1.55rem);
  }

  :global(html.js-anim) .flow {
    letter-spacing: 0.018em;
  }

  :global(html.js-anim) .flow.is-visible {
    letter-spacing: -0.01em;
    transition: letter-spacing 1.15s ease;
  }

  /* --- Cards --- */
  .card {
    background: var(--color-champagne);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-putty) 60%, transparent);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 34px -22px rgba(30, 42, 36, 0.45);
