    line-height: 1.35;
    color: var(--color-moss);
  }

  /* --- Our view --- */
  .view-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .view-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.6rem;
  }

  .view-num {
    color: var(--color-gold);
    font-size: 1.2rem;
  }

  .view-body {
