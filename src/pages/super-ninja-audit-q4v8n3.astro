  /* --- Stage timeline --- */
  .stages {
    position: relative;
    padding-left: 1.9rem;
  }

  .stages::before,
  .stages::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.55rem;
    bottom: 0.4rem;
    width: 1px;
  }

  .stages::before {
    background: var(--color-putty);
  }

  .stages::after {
    background: var(--color-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.35s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  .stages:has(.is-visible)::after {
    transform: scaleY(1);
  }

  .stage {
    position: relative;
    padding-bottom: 1.9rem;
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  .stage::before {
    content: "";
    position: absolute;
    left: -1.9rem;
    top: 0.28rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-ivory);
    border: 2px solid var(--color-gold);
    transition:
      background 0.45s ease,
      box-shadow 0.45s ease;
  }

  .stage.is-visible::before {
    background: var(--color-gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-gold) 22%, transparent);
  }

  .stage-eyebrow {
